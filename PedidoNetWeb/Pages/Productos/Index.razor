@page "/productos"
@using PedidoNetWeb.Models.Productos
@using PedidoNetWeb.Services.Productos
@using PedidoNetWeb.wwwroot.Component

@inject IProductoService ProductoService
@inject NavigationManager Navigation
<PageTitle>Productos</PageTitle>
<div class="contains-fluid py-4">
    <PageHeader Title="Productos"
    Descripcion="Consulta el catálogo de productos"/>

    @if(isLoading)
    {
        <LoadingIndicator Message="Cargando productos..." />
    }
    else if (errorMessage is not null)
    {
        <AlertMessage Message="@errorMessage"
            Dismissible="false" />
    
    }
    else if(productos.Count==0)
    {
        <AlertMessage Variant="info"
            Message="No hay productos registrados"
                      Dismissible="false" />
    }
    else
    {
        <ProductoTable Productos="@productos" />   
    }
</div>

@code {
    private List<ProductosDto> productos = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await ProductoService.GetAllAsync();
        }
        catch(UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch(HttpRequestException ex)
        {
            errorMessage = $"No fue posible consultar los productos. {ex.Message}";
        }
        catch(Exception ex)
        {
            errorMessage = $"Error inesperado:{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

}
