@page "/"

@using PedidoNetMobile.Models.Auth
@using PedidoNetMobile.Services.Auth
@using PedidoNetUIShared.Components.Shared

@* @inject IHttpClientFactory HttpClientFactory *@
@inject ITokenStorage TokenStorage
@inject AuthApiClient AuthApiClient

@* <AppTitle/>

<p> Cliente Mobile</p>
<p>Prueba de comunicación con la API</p>
<ApiTest></ApiTest> *@

<div>
    <label>
        Usuario
    </label>
    <input @bind="usuario"/>
</div>

<div>
    <label>
        Contraseña
    </label>
    <input @bind="password" type="password" />
</div>

<button @onclick="ProbarLogin">
    Probar Login
</button>

@if (mensaje.Contains("incorrecto"))
{
    <p style="color:red">@mensaje</p>
}
else
{
    <p>@mensaje</p>
}



@code {
    private string usuario = string.Empty;
    private string password = string.Empty;
    private string mensaje = "Sin probar";

    private async Task ProbarLogin()
    {
        try
        {
            mensaje = "Autenticando...";
            var request = new LoginRequest
                {
                    NombreUsuario = usuario,
                    Password = password
                };
            var response = await AuthApiClient.LoginAsync(request);
            if (response is null)
            {
                mensaje = "Usuario o contraseña incorrectos";
                return;
            }
            await TokenStorage.SaveAsync(response);
            mensaje = $"Bienvenido {response.NombreUsuario}. Rol: {response.Rol}";
        }
        catch(Exception e)
        {
            mensaje = $"Error: {e.Message}";
        }
    }
}